# PayPal sandbox credentials — never commit this file
# Copy to .env and fill with your *sandbox* app credentials.
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_secret
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Optional: defaults are MYR 25.00 for the Malaysian sandbox accounts.
PAYPAL_CURRENCY=MYR
PAYPAL_AMOUNT=25.00

# AI invoice extraction (DeepSeek is OpenAI-compatible)
AI_API_KEY=your_deepseek_api_key
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# Optional public-demo gate. Leave empty locally to disable.
DEMO_ACCESS_CODE=
SECRET_KEY=change-this-to-a-long-random-string
